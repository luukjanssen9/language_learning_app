# Copy to .env and fill in. Never commit the real .env file.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://language_app:language_app@localhost:5432/language_app
POSTGRES_USER=language_app
POSTGRES_PASSWORD=language_app
POSTGRES_DB=language_app

# --- LLM provider ---
# Default provider is Google Gemini (free tier, no billing setup required).
# Get a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
GEMINI_REASONING_MODEL=gemini-3.5-flash

# Optional: set if/when swapping in Anthropic as the provider.
# ANTHROPIC_API_KEY=

# --- Text-to-speech (vocab card audio) ---
# Google Cloud Text-to-Speech, not the Gemini key above -- a separate
# product with its own free tier (1M-4M characters/month) but different
# auth: a service-account JSON keyfile, not a simple API key. Download
# one from Google Cloud Console (IAM & Admin > Service Accounts). No
# predefined role scoped to just Text-to-Speech reliably shows up in the
# console's role picker (unlike Speech-to-Text, which has several) --
# use "Editor" and save the downloaded key as gcp-tts-credentials.json
# at the repo root (gitignored, same treatment as this .env file itself).
# No env var needed here -- docker-compose.yml points
# GOOGLE_APPLICATION_CREDENTIALS at that file directly.

# --- App ---
ENVIRONMENT=development
# Placeholder for later phases (real auth is not implemented in v1)
SECRET_KEY=dev-secret-change-me
# Origin allowed by the backend's CORS policy -- the Next.js dev server
FRONTEND_ORIGIN=http://localhost:3000
